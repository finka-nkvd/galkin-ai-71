import time
import random
import numpy as np

def matrix_gen(n):
    return np.random.randint(1, 101, size=(n, n))

start = int(input('введите номер задания от 1 до 4:\n'))

if start == 1:
    def bubble_sort(lst):
        n = len(lst)
        for i in range(n):
            for j in range(0, n - i - 1):
                if lst[j] > lst[j + 1]:
                    lst[j], lst[j + 1] = lst[j + 1], lst[j]
        return lst


    lst = [random.randint(1, 100) for i in range(10)]
    start_time = time.time()
    sorted_bubble = bubble_sort(lst.copy())
    bubble_time = time.time() - start_time

    start_time = time.time()
    sorted_builtin = sorted(lst)
    builtin_time = time.time() - start_time

    print(f"отсортированный массив (пузырьком): {sorted_bubble}")
    print(f"время выполнения пузырьковой сортировки: {bubble_time} секунд")
    print(f"отсортированный массив (встроенный метод): {sorted_builtin}")
    print(f"время выполнения встроенной сортировки: {builtin_time} секунд")

elif start == 2:
    def cyclic_shift(matrix):
        return np.roll(matrix, shift=1, axis=0)

    n = int(input("введите размер матрицы: "))
    matrix = matrix_gen(n)
    print("исходная матрица:")
    print(matrix)

    shifted_matrix = cyclic_shift(matrix)
    print("матрица после цикличного сдвига строк:")
    print(shifted_matrix)


elif start == 3:
    def sort_columns(matrix):
        rows, cols = matrix.shape
        for col in range(cols):
            for i in range(rows):
                min_index = i
                for j in range(i + 1, rows):
                    if matrix[j][col] < matrix[min_index][col]:
                        min_index = j
                matrix[i][col], matrix[min_index][col] = matrix[min_index][col], matrix[i][col]
        return matrix

    n = int(input("введите размер матрицы: "))
    matrix = matrix_gen(n)
    print("исходная матрица:")
    print(matrix)
    sorted_matrix = sort_columns(matrix)
    print("матрица после сортировки по столбцам:")
    print(sorted_matrix)

elif start == 4:
    def brute_sort(lst):
        max_value = lst[0]
        for num in lst:
            if num > max_value:
                max_value = num
        return max_value

    def bubble_sort(lst):
        n = len(lst)
        for i in range(n):
            for j in range(0, n - i - 1):
                if lst[j] > lst[j + 1]:
                    lst[j], lst[j + 1] = lst[j + 1], lst[j]
        return lst

    lst = [random.randint(1, 100) for i in range(10)]
    start_time = time.time()
    brute_sort(lst)
    brute_time = time.time() - start_time
    
    start_time = time.time()
    bubble_sort(lst)
    bubble_time = time.time() - start_time

    print(f"время методом перебора {brute_time} секунд)")
    print(f"время методом пузырьковой сортировки: {bubble_time} секунд")

else:
    print('неверный номер')
