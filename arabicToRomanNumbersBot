import telebot


def arabic_to_roman(num):
    val = [
        (1000, 'M'),
        (900, 'CM'),
        (500, 'D'),
        (400, 'CD'),
        (100, 'C'),
        (90, 'XC'),
        (50, 'L'),
        (40, 'XL'),
        (10, 'X'),
        (9, 'IX'),
        (5, 'V'),
        (4, 'IV'),
        (1, 'I')
    ]

    roman_numeral = ''

    for arabic, roman in val:
        while num >= arabic:
            roman_numeral += roman
            num -= arabic

    return roman_numeral

bot = telebot.TeleBot(token)

@bot.message_handler(commands=['start'])
def start_message(message):
    bot.send_message(message.chat.id, 'Введите число для перевода в римские:')

@bot.message_handler(content_types=['text'])
def handle_text(message):
    num = int(message.text)
    bot.send_message(message.chat.id, 'ваше римское число: ', arabic_to_roman(num))

bot.polling()
